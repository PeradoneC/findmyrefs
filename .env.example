# FindMyRefs environment variables (placeholders only - never commit real values).
#
# API keys are NOT read from environment variables. Configure the optional
# Anthropic API key in the app's Settings screen; it is stored in the Windows
# Credential Manager and never sent to the frontend.

# Optional: override the SQLite database location (useful for testing).
# FINDMYREFS_DB_PATH=C:\path\to\findmyrefs.sqlite
